{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "live.teamtime.desktop",
  "productName": "TeamTime",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-electron/**/*",
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/ui",
      "to": "ui",
      "filter": ["**/*"]
    },
    {
      "from": "resources/icon.png",
      "to": "icon.png"
    }
  ],
  "protocols": [
    {
      "name": "TeamTime",
      "schemes": ["teamtime"]
    }
  ],
  "win": {
    "icon": "resources/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TeamTime"
  },
  "mac": {
    "icon": "resources/icon.png",
    "category": "public.app-category.business"
  },
  "linux": {
    "icon": "resources/icon.png",
    "target": ["AppImage"],
    "category": "Office"
  }
}
