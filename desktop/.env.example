# Dev only: load the UI from a running Next server (hot reload).
# Leave unset to serve the bundled static UI over app://teamtime (run `npm run build:ui` first).
# DESKTOP_FRONTEND_URL=http://localhost:3000

# API + Socket.IO the UI talks to. Defaults to production when unset.
# A production backend must include app://teamtime in CORS_ORIGIN.
DESKTOP_API_URL=http://localhost:5000

# DESKTOP_OPEN_DEVTOOLS=1
