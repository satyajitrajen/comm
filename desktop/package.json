{
  "name": "teamtime-desktop",
  "version": "1.0.0",
  "description": "TeamTime desktop app — Electron shell serving the bundled Next.js UI",
  "main": "dist-electron/main/index.js",
  "author": "TeamTime",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "app": "node scripts/ensure-ui.mjs && vite",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "tsc && vite build && tsc -p tsconfig.node.json",
    "dist": "npm run build:ui && npm run build && electron-builder",
    "dist:skip-ui": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "productName": "TeamTime"
}
