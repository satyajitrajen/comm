[Unit]
Description=TeamTime Communication UI (Next.js)
After=network.target

[Service]
Type=simple
User=azureadmin
Environment=PATH=/home/azureadmin/.nvm/versions/node/v20.20.0/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=PORT=3000
WorkingDirectory=/home/azureadmin/communication/frontend
ExecStart=/home/azureadmin/.nvm/versions/node/v20.20.0/bin/npx next start -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
