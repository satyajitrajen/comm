# Copy to .env and adjust for your environment.

# --- Development (local npm run start:dev) ---
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://communication.impmeet.com
# DATABASE_URL="file:./dev.db"

# --- Production (bare metal on VM) ---
NODE_ENV=production
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
# Production only (add localhost entries if you also run next dev against this API):
CORS_ORIGIN=https://communication.impmeet.com
# Use absolute path outside the repo so deploys do not wipe data:
DATABASE_URL="file:/var/lib/teamtime/dev.db"

ACCESS_TOKEN_EXPIRES_IN=30m
# If true, OTP codes are printed in backend logs even when NODE_ENV=production (debug only).
TWO_FACTOR_LOG_OTP=false

# Global API rate limit (per user when JWT present, else per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=600

# Max file upload size in bytes (default 10 MB)
FILE_UPLOAD_MAX_BYTES=10485760

# Optional: Cloudinary for file storage. Format:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# If unset or upload fails, files are stored under backend/uploads/ locally.

# --- Email (SMTP) ---
# Required for password reset and for delivering 2FA codes. Without SMTP_HOST
# email is disabled: nothing is sent and messages are only written to the log,
# which means 2FA cannot be completed by a normal user.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for implicit TLS (port 465)
# SMTP_USER=no-reply@your-domain.com
# SMTP_PASS=replace-me
# SMTP_FROM="TeamTime <no-reply@your-domain.com>"

# Origin used to build links in outgoing email (password reset). Falls back to
# the request Origin header when unset.
# APP_ORIGIN=https://communication.impmeet.com

# --- Browser push (Web Push / VAPID) ---
# Generate once with: npx web-push generate-vapid-keys
# Without these, push is disabled and notifications remain in-app only.
# VAPID_PUBLIC_KEY=replace-me
# VAPID_PRIVATE_KEY=replace-me
# VAPID_SUBJECT=mailto:admin@your-domain.com

# --- FCM (Android + Firebase JS on web; optional) ---
# Path to a Firebase *service account* JSON file on the server. Never commit it.
# Local (gitignored): FIREBASE_SERVICE_ACCOUNT_PATH=.secrets/firebase-admin.json
# FIREBASE_SERVICE_ACCOUNT_PATH=/var/lib/teamtime/firebase-admin.json
# Or inline JSON (avoid in shared shells):
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Native apps typically send no Origin; CORS already allows missing Origin.
