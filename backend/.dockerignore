# Never bake local SQLite data into the image: the runtime DB lives on the
# /var/lib/teamtime volume and a baked copy silently shadows it.
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
prisma/prisma/
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Private keys and credentials — never bake into images
.secrets/
.env
.env.*
!.env.example
